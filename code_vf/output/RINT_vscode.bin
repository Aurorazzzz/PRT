±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<±–<